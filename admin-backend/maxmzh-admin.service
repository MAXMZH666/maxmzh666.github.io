[Unit]
Description=MAXMZH website admin backend
After=network.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/maxmzh-admin
ExecStart=/usr/bin/python3 /opt/maxmzh-admin/server.py
Environment=ADMIN_DATA_DIR=/opt/maxmzh-admin/data
Environment=ADMIN_PORT=8790
Environment=ADMIN_ACCESS_LOG=/var/log/nginx/access.log
Environment=ADMIN_SITE_DIR=/var/www/maxmzh
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/maxmzh-admin/data
ReadOnlyPaths=/var/log/nginx /var/www/maxmzh

[Install]
WantedBy=multi-user.target
